{
  "name": "@sibilsoren/gatekeeper",
  "version": "1.0.0",
  "description": "Production-grade, Redis-backed API rate limiting middleware for Express",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "lua"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "ratelimit",
    "express",
    "middleware",
    "redis",
    "api",
    "throttle",
    "token-bucket",
    "sliding-window"
  ],
  "author": "SibilSoren",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SibilSoren/gatekeeper.git"
  },
  "bugs": {
    "url": "https://github.com/SibilSoren/gatekeeper/issues"
  },
  "homepage": "https://github.com/SibilSoren/gatekeeper#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "express": "^5.1.0",
    "supertest": "^7.1.0",
    "typescript": "^5.8.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "vitest": "^3.1.3",
    "eslint": "^9.25.0",
    "@eslint/js": "^9.25.0",
    "typescript-eslint": "^8.30.0",
    "prettier": "^3.5.3"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
